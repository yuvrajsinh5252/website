# Local Environment Variables
# Copy this file to `.env` for local development:
# cp .env.example .env

# Feature flags (optional override):
# In development (`npm run dev`), dev tools (/logo-lab and palette preview) default to true.
# In production (`npm run build`), they default to false and are tree-shaken away.
# Uncomment below to force an override:
# VITE_DEV_TOOLS=true